NODE_ENV=production
PORT=4000

# MongoDB — use Railway's ${{MongoDB.MONGO_URL}} variable reference, or MongoDB Atlas URI
MONGODB_URI=mongodb://localhost:27017/veda_ai

# Redis — use Railway's ${{Redis.REDIS_URL}} variable reference
REDIS_URL=redis://localhost:6379

# Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Your Vercel deployment URL (no trailing slash)
FRONTEND_URL=https://your-app.vercel.app
